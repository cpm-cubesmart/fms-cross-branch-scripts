#!/usr/bin/env bash
#
# Refresh only the Zeitwerk checkout, then all three reports.
#
#   refresh/refresh-zeitwerk [--dry-run] [--anonymize]
#
# Two Rails boots instead of four -- zeitwerk-eager and zeitwerk-noeager. The
# main-eager and main-noeager snapshots already in runtime-snapshot/snapshots/
# are reused as they are, so all three reports still come out covering both
# branches: the reports read snapshots, not checkouts.
#
# The two reused snapshots are listed in preflight with their age and recorded
# eager_load, because a stale main side yields a report that reads as healthy.
# Run refresh/refresh-all when the base branch has moved.
#
# Everything here is refresh/refresh-all --only zeitwerk; that script holds all
# of the logic, and this one exists so the common case has a name. Arguments and
# the environment both pass straight through, so --anonymize and ANONYMIZE=1
# work here exactly as they do there.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec "$HERE/refresh-all" --only zeitwerk "$@"

#!/usr/bin/env bash
#
# Diff two snapshots.
#
#   bin/compare <label-a> <label-b> [options passed to the comparator]
#
# Example:
#   runtime-snapshot/bin/compare main-eager zeitwerk-eager
#   runtime-snapshot/bin/compare main-noeager zeitwerk-noeager --summary-only
#
# label-a should be the base/classic branch and label-b the Zeitwerk branch, so
# that the rename map's old -> new direction lines up.
#
# snapshots/renames.json and snapshots/ignore.txt are picked up automatically
# when they exist.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_DIR="$HERE/../script"
SNAPSHOT_DIR="${SNAPSHOT_DIR:-$HERE/../snapshots}"

if [ $# -lt 2 ]; then
  echo "Usage: $(basename "$0") <label-a> <label-b> [comparator options]" >&2
  echo "       (run the comparator with --help for the full option list)" >&2
  exit 2
fi

A="$SNAPSHOT_DIR/$1.json"
B="$SNAPSHOT_DIR/$2.json"
shift 2

for f in "$A" "$B"; do
  if [ ! -f "$f" ]; then
    echo "error: no such snapshot: $f" >&2
    echo "       available: $(ls "$SNAPSHOT_DIR"/*.json 2>/dev/null | grep -v '\.sources\.json$' | grep -v '/renames\.json$' | xargs -n1 basename 2>/dev/null | sed 's/\.json$//' | tr '\n' ' ')" >&2
    exit 2
  fi
done

ARGS=()
[ -f "$SNAPSHOT_DIR/renames.json" ] && ARGS+=(--renames "$SNAPSHOT_DIR/renames.json")
[ -f "$SNAPSHOT_DIR/ignore.txt" ] && ARGS+=(--ignore "$SNAPSHOT_DIR/ignore.txt")

exec ruby "$SCRIPT_DIR/compare_runtime_snapshots.rb" "$A" "$B" "${ARGS[@]}" "$@"

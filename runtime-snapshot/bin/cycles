#!/usr/bin/env bash
#
# Report files that were read while they were still loading.
#
#   bin/cycles <label> [options passed to the detector]
#
# Example:
#   runtime-snapshot/bin/cycles zeitwerk-eager
#   runtime-snapshot/bin/cycles main-eager --json
#
# Takes one snapshot, not a pair: re-entrancy is a property of a single boot.
# Run it on both branches to see which ones the migration introduced.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_DIR="$HERE/../script"
SNAPSHOT_DIR="${SNAPSHOT_DIR:-$HERE/../snapshots}"

if [ $# -lt 1 ]; then
  echo "Usage: $(basename "$0") <label> [detector options]" >&2
  echo "       (run the detector with --help for the full option list)" >&2
  exit 2
fi

SNAPSHOT="$SNAPSHOT_DIR/$1.json"
shift

if [ ! -f "$SNAPSHOT" ]; then
  echo "error: no such snapshot: $SNAPSHOT" >&2
  echo "       available: $(ls "$SNAPSHOT_DIR"/*.json 2>/dev/null | grep -v '\.sources\.json$' | grep -v '/renames\.json$' | xargs -n1 basename 2>/dev/null | sed 's/\.json$//' | tr '\n' ' ')" >&2
  exit 2
fi

exec ruby "$SCRIPT_DIR/find_load_cycles.rb" "$SNAPSHOT" "$@"
